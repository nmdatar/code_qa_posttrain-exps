# Copy to configs/eval.env (gitignored), edit, then source it in your shell.
# Supply an existing prepared dataset; the current smoke dataset has 3 questions.
export EVAL_DATA_DIR=/absolute/path/to/data/swe-qa-pro
# OpenAI-compatible endpoints INCLUDING /v1, without credentials in the URL.
export BASELINE_BASE_URL=https://YOUR_MODEL_HOST/v1
export JUDGE_BASE_URL=https://YOUR_JUDGE_HOST/v1
export JUDGE_MODEL=YOUR_JUDGE_MODEL_ID
# Set API keys privately in your shell or secret manager as MODEL_API_KEY
# and JUDGE_API_KEY. Existing saved W&B login is used automatically.
