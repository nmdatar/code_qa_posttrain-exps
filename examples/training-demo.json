{
  "backend": {"kind": "fake"},
  "model": {"base_model": "synthetic-bernoulli"},
  "run": {
    "run_id": "synthetic-demo",
    "seed": 7,
    "max_tokens": 8,
    "max_turns": 2,
    "temperature": 1.0,
    "checkpoint_every": 1,
    "eval_every": 1,
    "group_retries": 1,
    "stages": [
      {"strategy": "sft", "steps": 2, "learning_rate": 0.1},
      {"strategy": "grpo", "steps": 3, "learning_rate": 0.1, "batch_size": 2, "group_size": 4}
    ]
  },
  "tracking": {"mode": "disabled", "project": "training-eval-demo"}
}
