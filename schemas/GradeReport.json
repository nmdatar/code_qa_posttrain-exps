                "supported": {
                  "type": "boolean"
                },
                "complete": {
                  "type": "boolean"
                },
                "consistent": {
                  "type": "boolean"
                },
                "readable": {
                  "type": "boolean"
                },
                "material_error": {
                  "type": "boolean"
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
