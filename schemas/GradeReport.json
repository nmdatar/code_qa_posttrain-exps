                    "enum": [
                      "absent",
                      "partial",
                      "complete"
                    ]
                  },
                  "verdict": {
                    "enum": [
                      "supported",
                      "contradicted",
                      "insufficient"
                    ]
                  },
                  "material_error": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_keys": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
