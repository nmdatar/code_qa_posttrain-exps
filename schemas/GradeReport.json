  "required": [
    "schema_version",
    "reward_version",
    "task_id",
    "task_hash",
    "submission_hash",
    "family_id",
    "lineage_id",
    "split",
    "category",
    "answerability",
    "tier",
    "reward",
    "coverage",
    "efficiency",
    "checks",
    "reasons",
    "semantic",
    "metrics",
    "experiment_hash",
    "environment_id",
    "latency_enabled",
    "scoring_contract_hash",
    "planned_task_hashes",
    "compute_units",
    "diagram_present",
    "material_error",
    "judge_role",
    "candidate_preselected"
