      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "enum": [
                "1.0"
              ]
            },
            "task_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "submission_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "experiment_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "judge_family": {
              "type": "string",
              "minLength": 1
            },
            "judge_version": {
              "type": "string",
              "minLength": 1
            },
            "prompt_version": {
              "enum": [
                "1.0"
              ]
            },
            "snapshot_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
