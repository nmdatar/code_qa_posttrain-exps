{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradeReport",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "reward_version": {
      "enum": [
        "1.0"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "submission_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "answerability": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "failed",
        "partial",
        "accepted",
        "unresolved"
      ]
    },
    "reward": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ]
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "efficiency": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "defect",
              "failure",
              "unresolved"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "status",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
