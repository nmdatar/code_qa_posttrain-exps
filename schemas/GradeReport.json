                "1.0"
              ]
            },
            "task_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "submission_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "experiment_id": {
              "type": "string",
              "minLength": 1
            },
            "episode_id": {
              "type": "string",
              "minLength": 1
            },
            "trajectory_ref": {
              "type": "string",
              "minLength": 1
            },
            "latency_seconds": {
              "type": "number",
              "minimum": 0
            },
            "time_to_first_token_seconds": {
              "type": "number",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "tool_seconds": {
              "type": "number",
              "minimum": 0
            },
            "tool_calls": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
