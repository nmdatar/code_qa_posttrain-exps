    "compute_units": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "diagram_present": {
      "type": "boolean"
    },
    "material_error": {
      "type": "boolean"
    },
    "judge_role": {
      "enum": [
        "training",
        "evaluation"
      ]
    },
    "candidate_preselected": {
      "type": "boolean"
    }
