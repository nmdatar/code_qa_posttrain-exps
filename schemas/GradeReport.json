                "type": "object",
                "properties": {
                  "claim_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "citation_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "supported": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
