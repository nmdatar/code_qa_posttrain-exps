{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalGraph",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "entity",
          "label",
          "citations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "calls",
              "contains",
              "inherits",
              "data_flow",
              "precedes",
              "signals"
            ]
          },
          "condition": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "source",
          "target",
          "relation",
          "condition",
          "citations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
