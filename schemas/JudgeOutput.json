{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JudgeOutput",
  "type": "object",
  "properties": {
    "required_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "enum": [
              "absent",
              "partial",
              "complete"
            ]
          },
          "verdict": {
            "enum": [
              "supported",
              "contradicted",
              "insufficient"
            ]
          },
          "material_error": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "coverage",
          "verdict",
          "material_error",
          "reason",
          "evidence_keys"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "additional_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "enum": [
              "absent",
              "partial",
              "complete"
            ]
          },
          "verdict": {
            "enum": [
              "supported",
              "contradicted",
              "insufficient"
            ]
          },
          "material_error": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "coverage",
          "verdict",
          "material_error",
          "reason",
          "evidence_keys"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "citation_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "citation_id": {
            "type": "string",
            "minLength": 1
          },
          "supported": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claim_id",
          "citation_id",
          "supported",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "uncited_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "critical_error": {
      "type": "boolean"
    },
    "false_execution_claim": {
      "type": "boolean"
    },
    "answer_mode": {
      "enum": [
        "answer",
        "abstention",
        "clarification"
      ]
    },
    "answerability_satisfied": {
      "type": "boolean"
    },
    "diagram": {
      "type": "object",
      "properties": {
        "assessed": {
          "type": "boolean"
        },
        "supported": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "consistent": {
          "type": "boolean"
        },
        "readable": {
          "type": "boolean"
        },
        "material_error": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "assessed",
        "supported",
        "complete",
        "consistent",
        "readable",
        "material_error",
        "findings"
      ],
      "additionalProperties": false
    },
    "assessment_complete": {
      "type": "boolean"
    },
    "needs_review": {
      "type": "boolean"
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "required_claims",
    "additional_claims",
    "citation_links",
    "uncited_claim_ids",
    "critical_error",
    "false_execution_claim",
    "answer_mode",
    "answerability_satisfied",
    "diagram",
    "assessment_complete",
    "needs_review",
    "disagreements"
  ],
  "additionalProperties": false
}
