{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnswerSubmission",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "start_line",
          "end_line",
          "file_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "diagram": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "entity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "id",
                  "entity",
                  "label",
                  "citations"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "relation": {
                    "enum": [
                      "calls",
                      "contains",
                      "inherits",
                      "data_flow",
                      "precedes",
                      "signals"
                    ]
                  },
                  "condition": {
                    "type": "string"
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "source",
                  "target",
                  "relation",
                  "condition",
                  "citations"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "nodes",
            "edges"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mermaid": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mermaid"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "text",
    "citations",
    "diagram"
  ],
  "additionalProperties": false
}
