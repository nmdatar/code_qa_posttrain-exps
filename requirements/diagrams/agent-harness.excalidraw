      "version": 3,
      "versionNonce": 185773714,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790625475015,
      "created": 1790625475015,
      "link": null,
      "locked": false,
      "text": "Inner loop: policy updates. Outer loop: periodic evaluation and separately versioned harness experiments.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Loop back with the candidate policy; keep tools and budgets fixed within each RL experiment.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DGTz_OeQiNN3wqp3wSaFA",
      "type": "text",
      "x": 70,
      "y": 1700,
      "width": 1129.4315999999994,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 1854418987,
      "version": 2,
      "versionNonce": 1524106315,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790625475015,
      "created": 1790625475015,
      "link": null,
      "locked": false,
      "text": "Reward: failed = 0  |  partial = 0.2 × coverage  |  accepted = 0.9 + 0.1 × efficiency  |  unresolved = no reward",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reward: failed = 0  |  partial = 0.2 × coverage  |  accepted = 0.9 + 0.1 × efficiency  |  unresolved = no reward",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
